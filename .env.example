# Copy to .env for local shell usage. Do not commit .env.

# Databricks authentication. Prefer `databricks auth login` or a named profile.
# Uncomment host/token only if you are not using a Databricks CLI profile.
# DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
# DATABRICKS_TOKEN=
DATABRICKS_PROFILE=mma-fulltrial
DATABRICKS_WORKSPACE_ID=

# Bundle target and deploy-time variables.
DATABRICKS_BUNDLE_ENV=dev
DATABRICKS_CATALOG=migration_accelerator_dev
DATABRICKS_SPARK_VERSION=15.4.x-scala2.12
DATABRICKS_NODE_TYPE_ID=Standard_DS3_v2

# Full-solution integrations. Keep values empty until accounts are created.
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
AURA_INSTANCEID=
AURA_INSTANCENAME=
DATABRICKS_VECTOR_SEARCH_ENDPOINT=
MLFLOW_EXPERIMENT_NAME=/Shared/modern-migration-accelerator
MODEL_SERVING_ENDPOINT=

# Keep the default empty to use demo metadata uploaded to a Unity Catalog volume by scripts/run_accelerator_dev.sh.
# For customer metadata, point this to a Unity Catalog volume path such as:
# /Volumes/migration_accelerator_dev/landing/legacy_metadata
LEGACY_METADATA_SOURCE_ROOT=

# Optional local SQL Server fixture. Used only for local metadata extraction tests.
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433
SQLSERVER_CONTAINER_NAME=mma-legacy-sqlserver
LOCAL_METADATA_OUTPUT_DIR=local_outputs/legacy_metadata
